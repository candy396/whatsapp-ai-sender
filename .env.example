# Server Configuration
PORT=3000

# OpenAI API Key (Required for AI message generation / paraphrasing)
OPENAI_API_KEY=your_openai_api_key_here

# Optional Default AI Prompt
DEFAULT_AI_PROMPT="You are a professional assistant. Customize this message for the client in a friendly, conversational tone. Keep it concise."

# Minimum and Maximum delay (in seconds) between sent messages to prevent account bans
MIN_DELAY_SECONDS=5
MAX_DELAY_SECONDS=15
